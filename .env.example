# ==========================================
# SUPABASE (Banco, Auth e Storage)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Conexão PostgreSQL para Drizzle (Transaction Pooler porta 6543 + Direct porta 5432 para migrations)
DATABASE_URL=postgresql://postgres.[REF]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres:[SENHA]@db.[REF].supabase.co:5432/postgres

# ==========================================
# ALERTAS DIÁRIOS (Vercel Cron + Resend)
# ==========================================
CRON_SECRET=gere_uma_string_aleatoria_segura
RESEND_API_KEY=re_sua_chave_resend
ALERTAS_EMAIL_DESTINO=comercialfgv@terra.com.br
ALERTAS_EMAIL_REMETENTE=Alertas FGV <alertas@seudominio.com.br>

# ==========================================
# IA DE CONTEÚDO (Fase 2 - Gemini Flash)
# ==========================================
GEMINI_API_KEY=sua_chave_gemini_aqui

# ==========================================
# APP
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
